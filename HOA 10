    {
      "cell_type": "code",
      "source": [
        "df[\"Growth\"] = df[\"Sales\"].diff()\n",
        "\n",
        "max_growth = df[\"Growth\"].idxmax()\n",
        "min_growth = df[\"Growth\"].idxmin()\n",
        "\n",
        "colors = []\n",
        "for i in range(len(df)):\n",
        "    if i == max_growth:\n",
        "        colors.append(\"crimson\")\n",
        "    elif i == min_growth:\n",
        "        colors.append(\"royalblue\")\n",
        "    else:\n",
        "        colors.append(\"lightgray\")\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.bar(df[\"Month\"], df[\"Sales\"], color=colors)\n",
        "plt.title(\"Sales by Month (Crimson = Max Growth, Blue = Min Growth)\", fontsize=11)\n",
        "plt.ylabel(\"Sales\")\n",
        "plt.show()"
